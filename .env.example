# Copy to .env and fill values
PORT=4242
BASE_URL=http://localhost:4242

# Stripe (optional) - create a Checkout session when paymentMethod is 'card'
STRIPE_SECRET_KEY=

# Twilio (optional) - for automated WhatsApp confirmation
# TWILIO_WHATSAPP_FROM is the configured Twilio WhatsApp sender (e.g. +1415xxxxxxx)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Recipient number (without +) used for sending confirmation if you want to force a number
TWILIO_WHATSAPP_TO=

# Fallback default WhatsApp number for wa.me links (international format without +)
DEFAULT_WHATSAPP_NUMBER=919999999999

# Admin token to update order status
ADMIN_TOKEN=changeme
